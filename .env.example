# Database (Prisma reads DATABASE_URL only — the schema defines no DIRECT_URL)
# For Neon/pooled Postgres append: ?sslmode=require&connect_timeout=10&pool_timeout=10&pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/restaurant"

# Durable login/2FA rate limiting (optional — falls back to per-instance memory).
# Provision Upstash Redis or Vercel KV and set ONE of these pairs:
# KV_REST_API_URL="https://....upstash.io"   KV_REST_API_TOKEN="..."
# UPSTASH_REDIS_REST_URL="https://..."       UPSTASH_REDIS_REST_TOKEN="..."

# Auth.js / NextAuth v5 — the code reads AUTH_SECRET (NOT NEXTAUTH_SECRET).
# Generate with:  npx auth secret   (or: openssl rand -base64 33)
# AUTH_URL is not required — trustHost is enabled in src/lib/auth.config.ts.
AUTH_SECRET="your-secret-key"

# Pusher
PUSHER_APP_ID="your_app_id"
NEXT_PUBLIC_PUSHER_KEY="your_key"
PUSHER_SECRET="your_secret"
NEXT_PUBLIC_PUSHER_CLUSTER="your_cluster"

# SaaS Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_BASIC="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# Resend
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@localhost"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIza..."

# AI (Analytics advisor). AI_PROVIDER selects the backend, e.g. "gemini" or "openai".
AI_PROVIDER="gemini"
GEMINI_API_KEY="AIza..."
OPENAI_API_KEY="sk-..."

# UploadThing (image uploads)
UPLOADTHING_TOKEN="..."

# Cron Security (generate with: openssl rand -hex 32)
CRON_SECRET="your-cron-secret"

# Twilio (optional — for delivery tracking SMS notifications)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
